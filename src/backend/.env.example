# RAG runtime database. Start it from the repo root with:
#   docker compose up -d postgres
REDLINE_DATABASE_URL=postgresql+psycopg://redline:redline@127.0.0.1:5432/redline
REDLINE_UPLOADS_DIR=uploads
# Upload storage:
# - local: development only.
# - persistent-local: durable mounted disk.
# - ephemeral-demo: deploy demo only; uploaded documents and avatars can disappear.
# - object: S3-compatible storage such as Cloudflare R2 or Supabase Storage.
REDLINE_UPLOAD_STORAGE_BACKEND=local
REDLINE_OBJECT_STORAGE_ENDPOINT=
REDLINE_OBJECT_STORAGE_BUCKET=
REDLINE_OBJECT_STORAGE_REGION=
REDLINE_OBJECT_STORAGE_ACCESS_KEY_ID=
REDLINE_OBJECT_STORAGE_SECRET_ACCESS_KEY=
REDLINE_OBJECT_STORAGE_PUBLIC_BASE_URL=
REDLINE_DOCUMENT_UPLOAD_MAX_BYTES=26214400
# Use local for development. Set production/staging in deployed environments.
REDLINE_ENVIRONMENT=local
# Generate a unique value for each deploy, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
REDLINE_AUTH_SECRET=replace-with-a-random-32-byte-secret
# Auth sessions use HttpOnly cookies. Secure auto-enables outside local/dev/test unless overridden.
# REDLINE_AUTH_COOKIE_SECURE=true
REDLINE_AUTH_COOKIE_SAMESITE=lax
# Browser origins allowed to send cookie-authenticated requests.
# Local/dev can use the localhost regex below. Production must use exact HTTPS frontend origins.
# For Vercel frontend + Heroku backend, set this on Heroku to the exact Vercel URL:
#   REDLINE_CORS_ORIGINS=https://your-redline-app.vercel.app
# Multiple deployed origins can be comma-separated.
REDLINE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
REDLINE_CORS_ORIGIN_REGEX=https?://(127\.0\.0\.1|localhost|\[::1\])(:\d+)?$
REDLINE_GOOGLE_CLIENT_ID=
# Authentication throttling. Password login is intentionally stricter than Google login.
REDLINE_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
REDLINE_AUTH_REGISTER_RATE_LIMIT_MAX_ATTEMPTS=3
REDLINE_AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
REDLINE_AUTH_PASSWORD_CHANGE_RATE_LIMIT_MAX_ATTEMPTS=5
REDLINE_AUTH_GOOGLE_RATE_LIMIT_MAX_ATTEMPTS=10
REDLINE_AUTH_AVATAR_UPLOAD_RATE_LIMIT_MAX_ATTEMPTS=20
REDLINE_CONTRACT_CHAT_STREAMING_ENABLED=true
REDLINE_CONTRACT_CHAT_LLM_ENABLED=true

# AI provider for RAG-enhanced AI Review.
# Use direct Gemini by default. OpenAI-compatible remains supported for other providers.
# Contract Q&A uses this provider to synthesize grounded answers over retrieved RAG evidence.
REDLINE_AI_PRIMARY_PROVIDER=gemini
REDLINE_AI_FALLBACK_PROVIDER=

# OpenAI-compatible provider.
REDLINE_AI_OPENAI_API_KEY=
REDLINE_AI_OPENAI_MODEL=gpt-4.1-mini
# Leave empty for the official OpenAI endpoint, or set an OpenAI-compatible /v1 URL.
REDLINE_AI_OPENAI_BASE_URL=

# Gemini provider.
REDLINE_AI_GEMINI_API_KEY=
REDLINE_AI_GEMINI_MODEL=gemini-3.1-flash-lite

# Optional OpenAI-compatible fallback provider. Enable with:
#   REDLINE_AI_FALLBACK_PROVIDER=openai_fallback
REDLINE_AI_OPENAI_FALLBACK_API_KEY=
REDLINE_AI_OPENAI_FALLBACK_MODEL=
REDLINE_AI_OPENAI_FALLBACK_BASE_URL=

# Local batch generation tuning.
REDLINE_AI_BATCH_WORKER_ENABLED=true
REDLINE_AI_BATCH_CONCURRENCY=2
REDLINE_AI_BATCH_POLL_INTERVAL_MS=2000
REDLINE_AI_BATCH_STALE_ITEM_SECONDS=300
REDLINE_AI_BATCH_STALE_JOB_SECONDS=600
REDLINE_AI_BATCH_INTER_ITEM_DELAY=7.0
# Number of change items grouped into one provider call for Generate AI Review.
REDLINE_AI_REVIEW_BATCH_SIZE=5
# Maximum change items queued for one AI review job. Compare truth remains complete.
REDLINE_AI_REVIEW_MAX_ITEMS_PER_JOB=500

# RAG embeddings for parsed contract blocks and chat/review retrieval.
# Direct Gemini calls POST https://generativelanguage.googleapis.com/v1beta/openai/embeddings.
# REDLINE_RAG_EMBEDDING_API_KEY falls back to REDLINE_AI_GEMINI_API_KEY for Gemini's
# OpenAI-compatible endpoint when empty.
REDLINE_RAG_EMBEDDING_PROVIDER=openai_compatible
REDLINE_RAG_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
REDLINE_RAG_EMBEDDING_API_KEY=
REDLINE_RAG_EMBEDDING_MODEL=gemini-embedding-2
REDLINE_RAG_EMBEDDING_DIMENSIONS=3072
REDLINE_RAG_EMBEDDING_BATCH_SIZE=64
REDLINE_RAG_EMBEDDING_FALLBACK_TO_LOCAL_HASH=true

# PDF parser and local OCR fallback.
# On Windows, install Tesseract and verify both languages:
#   tesseract --list-langs
# For non-PATH installs, set REDLINE_TESSERACT_CMD to the executable path.
REDLINE_PDF_OCR_ENABLED=true
REDLINE_TESSERACT_CMD=
REDLINE_TESSDATA_PREFIX=
REDLINE_PDF_OCR_LANGUAGES=eng+vie
REDLINE_PDF_OCR_MIN_CONFIDENCE=80
REDLINE_PDF_OCR_MIN_RETAINED_TOKENS=12
REDLINE_PDF_OCR_MAX_LOW_CONFIDENCE_TOKEN_RATIO=0.25
REDLINE_PDF_OCR_DPI=200
REDLINE_PDF_TEXT_MIN_CHARS_PER_PAGE=40
REDLINE_PDF_TEXT_MIN_TOKENS_PER_PAGE=8
REDLINE_PDF_TEXT_MIN_PRINTABLE_RATIO=0.85
REDLINE_PDF_TEXT_MAX_DUPLICATE_TOKEN_RATIO=0.35
REDLINE_PDF_BLANK_PAGE_MAX_INK_RATIO=0.005
