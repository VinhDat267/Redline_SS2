# Frontend environment variables
# Copy this file to .env and fill in the values

# Backend API URL (Heroku production URL or localhost for dev)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google OAuth Web Client ID. Must match REDLINE_GOOGLE_CLIENT_ID in backend.
VITE_GOOGLE_CLIENT_ID=

# Contract Q&A streaming kill switch. Set false to use JSON fallback.
VITE_CONTRACT_CHAT_STREAMING_ENABLED=true
